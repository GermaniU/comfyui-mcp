# ComfyUI MCP Server Configuration

# Internal URL where ComfyUI instance is listening (loopback on host server)
COMFYUI_URL=http://127.0.0.1:8188

# Public/LAN base URL used for direct client image downloads (accessible across network)
COMFYUI_PUBLIC_URL=http://<YOUR_SERVER_IP>:8188

# MCP Server Binding Options
MCP_HOST=0.0.0.0
MCP_PORT=8201

# Optional Bearer token authentication (empty = auth disabled for trusted LAN)
# MCP_AUTH_TOKEN=your-secret-token-here

# Path to local ComfyUI output directory (if filesystem is shared, optional)
COMFYUI_OUTPUT_DIR=/home/user/stack/comfyui/output
