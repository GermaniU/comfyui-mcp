[Unit]
Description=comfyui-mcp — MCP HTTP server (generate_image/list_models/comfy_health), puerto 8201
After=network.target

[Service]
Type=simple
User=<usuario>
WorkingDirectory=/ruta/al/repo
Environment=COMFYUI_URL=http://127.0.0.1:8188
Environment=MCP_PORT=8201
ExecStart=/ruta/al/repo/venv/bin/python /ruta/al/repo/comfyui_mcp.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target