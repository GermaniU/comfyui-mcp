[Unit]
Description=comfyui-mcp — MCP HTTP server para ComfyUI, puerto 8201
After=network.target

[Service]
Type=simple
User=<YOUR_USER>
WorkingDirectory=<HOME>/Sites/comfyui-mcp
Environment=COMFYUI_URL=http://127.0.0.1:8188
Environment=COMFYUI_PUBLIC_URL=http://<YOUR_SERVER_IP>:8188
Environment=MCP_PORT=8201
ExecStart=<HOME>/Sites/comfyui-mcp/.venv/bin/comfyui-mcp
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
